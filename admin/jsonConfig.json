{
	"i18n": true,
	"type": "panel",
	"items": {
		"connection": {
			"type": "panel",
			"label": "Connection settings",
			"items": {
				"useIpv6": {
					"type": "checkbox",
					"label": "Use IPv6 instead of IPv4",
					"default": false,
					"xs": 12,
					"md": 6,
					"lg": 4,
					"xl": 3,
					"sm": 12
				},
				"ipV4": {
					"type": "text",
					"label": "Gateway IPv4 address",
					"default": "192.168.178.8",
					"xs": 12,
					"md": 6,
					"lg": 4,
					"xl": 3,
					"sm": 6,
					"hidden": "data.useIpv6 === true"
				},
				"ipV6": {
					"type": "text",
					"label": "Gateway IPv6 address",
					"default": "",
					"xs": 12,
					"md": 6,
					"lg": 4,
					"xl": 3,
					"sm": 6,
					"hidden": "data.useIpv6 !== true"
				},
				"username": {
					"type": "text",
					"label": "Username",
					"default": "",
					"xs": 12,
					"md": 6,
					"lg": 4,
					"xl": 3,
					"sm": 6
				},
				"password": {
					"type": "password",
					"label": "Password",
					"default": "",
					"xs": 12,
					"md": 6,
					"lg": 4,
					"xl": 3,
					"sm": 6
				}
			}
		},
		"support": {
			"type": "panel",
			"label": "Support the project ❤️",
			"items": {
				"supportInfo": {
					"type": "staticText",
					"text": "Support information",
					"xs": 12,
					"md": 12,
					"lg": 12,
					"xl": 12,
					"sm": 12
				},
				"kofiLink": {
					"type": "staticLink",
					"label": "☕ Donate via Ko-fi (Recommended)",
					"href": "https://ko-fi.com/crypt01101111",
					"button": true,
					"color": "primary",
					"xs": 12,
					"md": 6,
					"lg": 4,
					"xl": 3,
					"sm": 6
				},
				"paypalLink": {
					"type": "staticLink",
					"label": "💸 Donate via PayPal",
					"href": "https://paypal.me/ItMediaSolutions",
					"button": true,
					"color": "secondary",
					"xs": 12,
					"md": 6,
					"lg": 4,
					"xl": 3,
					"sm": 6
				}
			}
		}
	}
}
